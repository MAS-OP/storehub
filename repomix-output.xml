      name: form.storeName,
      name_ar: form.storeNameAr || form.storeName,
      subdomain: form.subdomain,
      primary_color: form.primaryColor,
      owner_id: user.id,
      country: "SA",
      currency: "SAR",
      is_active: true,
      ai_enabled: true,
    });

