import { NextRequest, NextResponse } from 'next/server'

interface OrderItem {
  name: string
  qty: number
  price: number
}

interface EmailOrderPayload {
  to: string
  customerName: string
  orderNumber: string
  storeName: string
  items: OrderItem[]
