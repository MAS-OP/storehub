@import "tailwindcss";

:root {
  --background: 30 20% 98%;
  --foreground: 220 20% 10%;

  --card: 0 0% 100%;
  --card-foreground: 220 20% 10%;

  --popover: 0 0% 100%;
  --popover-foreground: 220 20% 10%;

  --primary: 220 20% 15%;
  --primary-foreground: 0 0% 100%;

  --secondary: 30 15% 94%;
  --secondary-foreground: 220 20% 15%;

  --muted: 30 10% 92%;
  --muted-foreground: 220 10% 45%;

  --accent: 15 85% 60%;
  --accent-foreground: 0 0% 100%;

  --destructive: 0 84% 60%;
  --destructive-foreground: 0 0% 100%;

  --border: 30 15% 90%;
  --input: 30 15% 90%;
  --ring: 15 85% 60%;

  --radius: 1rem;

  --shadow-soft: 0 2px 8px -2px hsl(220 20% 10% / 0.08), 0 4px 16px -4px hsl(220 20% 10% / 0.12);
  --shadow-card: 0 1px 3px hsl(220 20% 10% / 0.04), 0 4px 12px hsl(220 20% 10% / 0.06);
  --shadow-elevated: 0 8px 30px -8px hsl(220 20% 10% / 0.15);

  --gradient-warm: linear-gradient(135deg, hsl(15 85% 60%) 0%, hsl(25 90% 55%) 100%);
  --gradient-surface: linear-gradient(180deg, hsl(30 20% 99%) 0%, hsl(30 15% 96%) 100%);

  --tab-bar-height: 5rem;
  --header-height: 4rem;
}

.dark {
  --background: 220 20% 8%;
  --foreground: 30 20% 98%;

  --card: 220 20% 12%;
  --card-foreground: 30 20% 98%;

  --popover: 220 20% 12%;
  --popover-foreground: 30 20% 98%;

  --primary: 30 20% 98%;
  --primary-foreground: 220 20% 10%;

  --secondary: 220 15% 18%;
  --secondary-foreground: 30 20% 98%;

  --muted: 220 15% 20%;
  --muted-foreground: 30 10% 60%;

  --accent: 15 85% 55%;
  --accent-foreground: 0 0% 100%;

  --border: 220 15% 20%;
  --input: 220 15% 20%;
  --ring: 15 85% 55%;
}

/* Tailwind v4: maps raw HSL custom properties above to real utility classes (bg-primary, text-accent, etc.) */
@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));

  --radius-lg: var(--radius);
  --radius-md: calc(var(--radius) - 4px);
  --radius-sm: calc(var(--radius) - 8px);

  --font-arabic: "Cairo", system-ui, sans-serif;
  --font-sans: "Inter", system-ui, sans-serif;
}

@layer base {
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -webkit-tap-highlight-color: transparent;
  }

  [lang="ar"] { font-family: var(--font-arabic); direction: rtl; }
  [lang="en"] { font-family: var(--font-sans); direction: ltr; }

  body {
    @apply bg-background text-foreground antialiased;
    margin: 0;
    padding: 0;
  }

  ::selection { background-color: hsl(var(--accent)); color: white; }

  ::-webkit-scrollbar { width: 6px; }
  ::-webkit-scrollbar-track { background: hsl(var(--muted)); }
  ::-webkit-scrollbar-thumb { background: hsl(var(--accent)); border-radius: 3px; }

  /* Touch targets */
  button, a, [role="button"] {
    min-height: 44px;
    min-width: 44px;
  }

  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar { display: none; }
}

@layer components {
  .card-elevated {
    @apply bg-card rounded-2xl;
    box-shadow: var(--shadow-card);
  }

  .card-product {
    @apply bg-card rounded-2xl overflow-hidden transition-all duration-300;
    box-shadow: var(--shadow-card);
  }
  .card-product:hover {
    box-shadow: var(--shadow-elevated);
    transform: translateY(-2px);
  }

  .btn-accent {
    @apply bg-accent text-accent-foreground font-semibold rounded-xl px-6 py-3 transition-all duration-200;
    box-shadow: 0 4px 14px -4px hsl(var(--accent) / 0.4);
  }
  .btn-accent:hover {
    transform: translateY(-1px);
    box-shadow: 0 6px 20px -4px hsl(var(--accent) / 0.5);
  }
  .btn-accent:active { transform: translateY(0); }

  .tab-bar {
    @apply fixed bottom-0 left-0 right-0 bg-card/80 backdrop-blur-xl border-t border-border;
    height: var(--tab-bar-height);
    padding-bottom: env(safe-area-inset-bottom);
  }

  .header-blur {
    @apply bg-background/80 backdrop-blur-xl border-b border-border;
  }

  .category-chip {
    @apply bg-secondary text-secondary-foreground px-4 py-2.5 rounded-full font-medium text-sm whitespace-nowrap transition-colors;
  }
  .category-chip:hover, .category-chip.active {
    @apply bg-primary text-primary-foreground;
  }

  .skeleton-shimmer { @apply bg-muted animate-pulse rounded-xl; }

  .price-tag { @apply text-2xl font-bold text-foreground; }
  .price-currency { @apply text-sm font-medium text-muted-foreground; }

  /* RTL specific adjustments */
  [dir="rtl"] .carousel-nav-prev { right: auto; left: 1rem; transform: rotate(180deg); }
  [dir="rtl"] .carousel-nav-next { left: auto; right: 1rem; transform: rotate(180deg); }

  .safe-area-top { padding-top: env(safe-area-inset-top); }
  .safe-area-bottom { padding-bottom: calc(var(--tab-bar-height) + env(safe-area-inset-bottom)); }

  .page-transition { @apply transition-all duration-300 ease-out; }
}

@layer utilities {
  .text-gradient {
    @apply bg-clip-text text-transparent;
    background-image: var(--gradient-warm);
  }
}

@layer utilities {
  .glass {
    @apply bg-card/70 backdrop-blur-xl border border-border;
  }
  .glass-brand {
    @apply bg-accent/10 backdrop-blur-xl border border-accent/25;
  }
  .gradient-brand {
    background-image: var(--gradient-warm);
  }
  .glow-brand {
    box-shadow: 0 0 40px hsl(var(--accent) / 0.35), 0 0 80px hsl(var(--accent) / 0.15);
  }
  .gradient-text {
    @apply bg-clip-text text-transparent;
    background-image: var(--gradient-warm);
  }
  .gradient-text-gold {
    @apply bg-clip-text text-transparent;
    background-image: linear-gradient(135deg, hsl(35 90% 55%) 0%, hsl(15 85% 55%) 100%);
  }
  .float {
    animation: float 6s ease-in-out infinite;
  }
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-12px); }
  }
  .noise::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
  }
}
