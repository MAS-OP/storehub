              {isAr ? "تسجيل الخروج" : "Sign out"}
            </button>
          </form>
        </div>
      </aside>

      {/* ── Main content ── */}
      <main className="flex-1 ms-64 min-h-screen">
        {children}
      </main>
    </div>
  );
}
