): Promise<void> {
  const supabase = createClient();
  const { error } = await supabase
    .from("store_sections")
    .update({ config: config as unknown as Json })
    .eq("id", id);
  if (error) throw error;
}

export async function toggleSectionActive(id: string, isActive: boolean): Promise<void> {
